generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HomeType {
  apartment
  house
  villa
  other
}

enum DeviceProtocol {
  wifi
  bluetooth
  zigbee
  matter
  mqtt
  other
}

enum DeviceAvailability {
  online
  offline
  unknown
}

enum MembershipRole {
  ADMIN
  USER
  VIEWER
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  SUCCEEDED
  FAILED
  TIMEOUT
  EXPIRED
}

enum AlertSeverity {
  info
  warning
  critical
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

enum AlertType {
  HIGH_ELECTRICITY
  ABNORMAL_WATER
  POSSIBLE_LEAK
  DEVICE_OFFLINE
  SENSOR_ERROR
}

enum AggregatePeriod {
  hour
  day
  week
  month
}

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  createdAt    DateTime @default(now())

  ownedHomes   Home[]       @relation("HomeOwner")
  memberships  Membership[]
  auditLogs    AuditLog[]
  acknowledged Alert[]      @relation("AlertAck")
  commands     Command[]
}

model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  sites     Site[]
  homes     Home[]
}

model Site {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  timezone       String       @default("Asia/Jakarta")
  buildings      Building[]
  homes          Home[]
  gateways       Gateway[]
}

model Gateway {
  id        String    @id
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  version   String?
  lastSeen  DateTime?
  createdAt DateTime  @default(now())
}

model Building {
  id      String   @id
  siteId  String
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name    String
  floors  Floor[]
  homes   Home[]
  vendors Vendor[]
}

model Floor {
  id         String   @id
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  homes      Home[]
}

model Home {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  siteId         String?
  site           Site?        @relation(fields: [siteId], references: [id])
  buildingId     String?
  building       Building?    @relation(fields: [buildingId], references: [id])
  floorId        String?
  floor          Floor?       @relation(fields: [floorId], references: [id])
  ownerId        String
  owner          User         @relation("HomeOwner", fields: [ownerId], references: [id])
  name           String
  type           HomeType     @default(house)
  location       String       @default("")
  createdAt      DateTime     @default(now())

  rooms            Room[]
  devices          Device[]
  memberships      Membership[]
  telemetry        TelemetryReading[]
  aggregates       TelemetryAggregate[]
  commands         Command[]
  automations      AutomationRule[]
  alerts           Alert[]
  motionEvents     MotionEvent[]
  utilityConfig    UtilityConfig?
  alertThresholds  AlertThreshold[]
  orders           Order[]
  prepaidAccount   PrepaidAccount?
  invoices         Invoice[]
  accessPasses     AccessPass[]
  accessLogs       AccessLog[]
}

model Membership {
  userId String
  homeId String
  role   MembershipRole
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  home   Home           @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@id([userId, homeId])
}

model Room {
  id        String   @id
  homeId    String
  home      Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  createdAt DateTime @default(now())
  devices   Device[]
  alerts    Alert[]
}

model Device {
  id              String             @id
  homeId          String
  home            Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  roomId          String
  room            Room               @relation(fields: [roomId], references: [id])
  type            String
  name            String
  protocol        DeviceProtocol     @default(mqtt)
  status          DeviceAvailability @default(unknown)
  lastSeen        DateTime?
  lastHeartbeat   DateTime?
  ipAddress       String?
  firmwareModel   String?
  firmwareVersion String?
  hardwareVersion String?
  nodeId          String?
  macAddress      String?
  buildNumber     Int?
  config          Json?
  claimToken      String?
  isOn            Boolean?
  createdAt       DateTime           @default(now())

  @@index([nodeId])

  capabilities DeviceCapability[]
  credential   DeviceCredential?
  sensors      Sensor[]
  telemetry    TelemetryReading[]
  aggregates   TelemetryAggregate[]
  counters     DeviceCounterSnapshot[]
  heartbeats   DeviceHeartbeat[]
  lighting     LightingState?
  commands     Command[]
  motionEvents MotionEvent[]
  alerts       Alert[]
}

model DeviceCapability {
  deviceId   String
  capability String
  device     Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([deviceId, capability])
}

model DeviceCredential {
  deviceId         String @id
  device           Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  mqttUsername     String @unique
  mqttPasswordHash String
  deviceSecretHash String
}

// One physical ESP32 board. Real multi-device firmware authenticates once per board
// with this credential (ACL scoped to exactly the devices it hosts) instead of once
// per logical device. nodeId is the MQTT username. No FK: nodes are identified by the
// nodeId string on Device, not a Node table.
model NodeCredential {
  nodeId           String @id
  homeId           String
  mqttUsername     String @unique
  mqttPasswordHash String
}

model Sensor {
  id       String @id @default(cuid())
  deviceId String
  device   Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind     String
  label    String
}

model TelemetryReading {
  id         String   @id @default(cuid())
  homeId     String
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  recordedAt DateTime
  metrics    Json
  createdAt  DateTime @default(now())

  @@unique([deviceId, recordedAt])
  @@index([homeId, recordedAt])
  @@index([createdAt])
}

model DeviceCounterSnapshot {
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  metric     String
  value      Float
  recordedAt DateTime
  updatedAt  DateTime @updatedAt

  @@id([deviceId, metric])
}

model TelemetryAggregate {
  id          String          @id @default(cuid())
  homeId      String
  home        Home            @relation(fields: [homeId], references: [id], onDelete: Cascade)
  deviceId    String
  device      Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  period      AggregatePeriod
  periodStart DateTime
  metric      String
  avg         Float
  min         Float
  max         Float
  sum         Float
  last        Float
  first       Float?
  sampleCount Int             @default(0)

  @@unique([deviceId, period, periodStart, metric])
  @@index([homeId, period, periodStart])
}

model MotionEvent {
  id         String   @id @default(cuid())
  homeId     String
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  kind       String
  occurredAt DateTime

  @@index([homeId, occurredAt])
}

model LightingState {
  deviceId   String   @id
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  isOn       Boolean
  brightness Int?
  updatedAt  DateTime @updatedAt
}

model Command {
  id              String        @id @default(cuid())
  homeId          String
  home            Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  deviceId        String
  device          Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdById     String?
  createdBy       User?         @relation(fields: [createdById], references: [id])
  type            String
  params          Json
  idempotencyKey  String
  status          CommandStatus @default(PENDING)
  error           String?
  createdAt       DateTime      @default(now())
  sentAt          DateTime?
  acknowledgedAt  DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?

  ack CommandAcknowledgement?

  @@unique([homeId, idempotencyKey])
  @@index([status, createdAt])
}

model CommandAcknowledgement {
  id         String   @id @default(cuid())
  commandId  String   @unique
  command    Command  @relation(fields: [commandId], references: [id], onDelete: Cascade)
  payload    Json
  receivedAt DateTime @default(now())
}

model AutomationRule {
  id          String   @id @default(cuid())
  homeId      String
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean  @default(true)
  trigger     Json
  conditions  Json
  actions     Json
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  executions  AutomationExecution[]
}

model AutomationExecution {
  id          String         @id @default(cuid())
  ruleId      String
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status      String
  triggeredAt DateTime       @default(now())
  result      Json?
}

model Alert {
  id              String        @id @default(cuid())
  homeId          String
  home            Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  deviceId        String?
  device          Device?       @relation(fields: [deviceId], references: [id])
  roomId          String?
  room            Room?         @relation(fields: [roomId], references: [id])
  severity        AlertSeverity
  type            AlertType
  title           String
  message         String
  status          AlertStatus   @default(open)
  createdAt       DateTime      @default(now())
  acknowledgedAt  DateTime?
  acknowledgedById String?
  acknowledgedBy  User?         @relation("AlertAck", fields: [acknowledgedById], references: [id])

  @@index([homeId, createdAt])
}

model DeviceHeartbeat {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  receivedAt DateTime @default(now())
  rssi       Int?

  @@index([deviceId, receivedAt])
}

model UtilityConfig {
  homeId                    String @id
  home                      Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  electricityTariffPerKwh   Decimal @db.Decimal(12, 4)
  waterTariffPerM3          Decimal @db.Decimal(12, 4)
  serviceChargeIdr          Int     @default(0) // IPL / iuran pengelolaan per month
  currency                  String  @default("IDR")
}

model AlertThreshold {
  id         String        @id @default(cuid())
  homeId     String
  home       Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  type       AlertType
  metric     String
  op         String
  value      Float
  forSeconds Int           @default(0)
  severity   AlertSeverity
  enabled    Boolean       @default(true)

  @@unique([homeId, type, metric])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─── Prepaid utility wallet (opt-in per unit) ────────────────────────────────

// A prepaid balance in IDR that covers a unit's metered electricity + water.
// Opt-in: when `enabled`, telemetry deltas are priced with UtilityConfig tariffs
// and deducted from `balanceIdr`. When the balance runs out, the configured
// relay/valve devices are auto-cut (TURN_OFF) via the normal command pipeline
// and reconnected (TURN_ON) on the next top-up — the PLN-token model extended
// to water. Units that leave `enabled` false are billed postpaid instead.
model PrepaidAccount {
  homeId                   String   @id
  home                     Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  enabled                  Boolean  @default(false)
  balanceIdr               Decimal  @default(0) @db.Decimal(14, 2)
  lowBalanceThresholdIdr   Int      @default(20000)
  // Devices driven when the balance hits zero / is topped up. Null = no cut for
  // that utility (monitoring only). These are on_off relay/valve devices.
  electricityRelayDeviceId String?
  waterValveDeviceId       String?
  disconnected             Boolean  @default(false)
  lowNotifiedAt            DateTime?
  updatedAt                DateTime @updatedAt
  transactions             PrepaidTransaction[]
}

model PrepaidTransaction {
  id              String   @id @default(cuid())
  homeId          String
  account         PrepaidAccount @relation(fields: [homeId], references: [homeId], onDelete: Cascade)
  kind            String   // topup | usage | adjustment
  amountIdr       Decimal  @db.Decimal(14, 2) // positive = credit, negative = debit
  balanceAfterIdr Decimal  @db.Decimal(14, 2)
  description     String   @default("")
  meta            Json?
  createdAt       DateTime @default(now())

  @@index([homeId, createdAt])
}

// ─── Access control (guest passes + door log) ────────────────────────────────

// A time-boxed credential to open a unit's / lobby's solenoid lock. Issued by a
// resident for a guest or a kiosk courier; verified at a door panel by PIN or by
// the QR token. Reuses the lock actuator's command→ack→state contract.
model AccessPass {
  id          String    @id @default(cuid())
  homeId      String
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdById String?
  label       String    // guest name or "Kurir Kios"
  kind        String    @default("guest") // guest | courier | resident
  pin         String    // 6-digit code
  token       String    @unique // opaque QR token
  validFrom   DateTime  @default(now())
  validUntil  DateTime
  maxUses     Int       @default(0) // 0 = unlimited within the window
  uses        Int       @default(0)
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  logs        AccessLog[]

  @@index([homeId, createdAt])
}

model AccessLog {
  id         String   @id @default(cuid())
  homeId     String
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  passId     String?
  pass       AccessPass? @relation(fields: [passId], references: [id])
  deviceId   String?
  action     String   // granted | denied | resident_unlock
  actorLabel String
  reason     String?
  occurredAt DateTime @default(now())

  @@index([homeId, occurredAt])
}

// ─── Billing (postpaid utility + IPL invoices) ───────────────────────────────

enum InvoiceStatus {
  unpaid
  paid
  overdue
  void
}

// A monthly bill for one unit: metered electricity + water (skipped for prepaid
// units, which pay upfront) plus the IPL / service charge. Generated by the
// building manager from telemetry aggregates; paid by the resident (simulated).
model Invoice {
  id           String        @id @default(cuid())
  homeId       String
  home         Home          @relation(fields: [homeId], references: [id], onDelete: Cascade)
  periodStart  DateTime      // first day of the billed month (UTC)
  periodLabel  String        // e.g. "Agustus 2026"
  status       InvoiceStatus @default(unpaid)
  totalIdr     Int
  dueDate      DateTime
  paidAt       DateTime?
  paymentChannel String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lines        InvoiceLine[]

  @@unique([homeId, periodStart])
  @@index([homeId, createdAt])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind        String  // electricity | water | ipl | other
  description String
  quantity    Float   @default(0)
  unit        String  @default("")
  amountIdr   Int

  @@index([invoiceId])
}

// ─── Commerce (in-building marketplace / kiosk) ──────────────────────────────

// A kiosk / seller scoped to one building. Residents of that building order
// from it and it delivers to their unit — the "kios lantai bawah" model.
model Vendor {
  id         String    @id
  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  floorLabel String    @default("Lantai 1")
  emoji      String    @default("🏪")
  active     Boolean   @default(true)
  products   Product[]
  orders     Order[]
}

model Product {
  id          String      @id
  vendorId    String
  vendor      Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name        String
  category    String
  emoji       String      @default("📦")
  description String      @default("")
  priceIdr    Int
  unit        String?
  etaMinutes  Int         @default(20)
  available   Boolean     @default(true)
  orderItems  OrderItem[]

  @@index([vendorId])
}

enum OrderStatus {
  confirmed
  preparing
  delivering
  completed
  cancelled
}

model Order {
  id             String      @id @default(cuid())
  homeId         String
  home           Home        @relation(fields: [homeId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  status         OrderStatus @default(confirmed)
  paymentChannel String // qris | cash | virtual_account | bank_transfer | credit_card
  paymentStatus  String // pending | paid
  totalIdr       Int
  note           String?
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([homeId, createdAt])
  @@index([vendorId, status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  emoji     String   @default("📦")
  priceIdr  Int
  qty       Int

  @@index([orderId])
}
