# ---------------------------------------------------------------------------
# HUNI — Environment Variables (example)
# ---------------------------------------------------------------------------
# Phase 1 is a fully client-side mock build and requires NO environment
# variables to run. `npm run dev` / `npm run build` work with this file absent.
#
# To use a local override, copy this file to `.env.local`:
#     cp .env.example .env.local
#
# The variables below are placeholders for LATER phases (real API / auth /
# payment integrations). They are NOT read by any current code — uncomment and
# wire them up only when those integrations are actually implemented.
# Never commit real secrets; `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# App identity (safe to expose; NEXT_PUBLIC_ is bundled into client code)
# NEXT_PUBLIC_APP_NAME=HUNI
# NEXT_PUBLIC_APP_ENV=development

# Toggle mock data / mock integrations (Phase 2+)
# NEXT_PUBLIC_ENABLE_MOCK_DATA=true
# NEXT_PUBLIC_ENABLE_PAYMENT_MOCK=true
# NEXT_PUBLIC_ENABLE_AI_MOCK=true

# Backend API base URL (Phase 2+)
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only secrets (Phase 2+) — do NOT prefix with NEXT_PUBLIC_
# AUTH_SECRET=
# DATABASE_URL=
