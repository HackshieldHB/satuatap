# ---------------------------------------------------------------------------
# SATU ATAP — Environment
# ---------------------------------------------------------------------------
# Frontend (Next.js) still runs with NO env vars (mock mode).
# Copy to .env.local to talk to the real API:
#   NEXT_PUBLIC_ENABLE_MOCK_DATA=false
#   NEXT_PUBLIC_API_URL=http://localhost:3001
# ---------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=SATU ATAP
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-only (API / Prisma / Gateway) — never prefix NEXT_PUBLIC_
DATABASE_URL=postgresql://satuatap:satuatap@127.0.0.1:5432/satuatap
JWT_SECRET=local-dev-jwt-secret-change-me
INTERNAL_API_KEY=local-internal-key
GATEWAY_URL=http://127.0.0.1:3100
API_URL=http://127.0.0.1:3001
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=gateway
MQTT_PASSWORD=local-dev-mqtt-gateway
MQTT_SIMULATOR_USERNAME=simulator
MQTT_SIMULATOR_PASSWORD=local-dev-mqtt-simulator
EDGE_DB_PATH=edge.sqlite
EDGE_LOCAL_TOKEN=local-edge-token
EDGE_URL=http://127.0.0.1:3100
NEXT_PUBLIC_EDGE_URL=/api/edge
CORS_ORIGIN=http://localhost:3000
PORT=3001

# Telegram notifications (optional). Create a bot with @BotFather, paste the
# token here and set the bot's @username. Leave blank to run without Telegram —
# notifications still fan out over SSE and delivery becomes a logged no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# After deploying, point the bot at the webhook:
#   https://api.telegram.org/bot<token>/setWebhook?url=<public-url>/v1/telegram/webhook
