{
  "name": "satu-atap",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "npm test -w @satu-atap/shared && npm test -w @satu-atap/api && npm test -w @satu-atap/iot-gateway",
    "dev:api": "npm run dev -w @satu-atap/api",
    "dev:gateway": "npm run dev -w @satu-atap/iot-gateway",
    "dev:simulator": "npm run start -w @satu-atap/iot-simulator",
    "db:generate": "npm run generate -w @satu-atap/db",
    "db:migrate": "npm run migrate -w @satu-atap/db",
    "db:migrate:deploy": "npm run migrate:deploy -w @satu-atap/db",
    "db:seed": "npm run seed -w @satu-atap/db",
    "stack:up": "docker compose up -d postgres mosquitto",
    "stack:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
